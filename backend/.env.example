# AI Email Summarizer - Backend Environment Configuration

PROJECT_NAME="AI Email Summarizer"
ENVIRONMENT="development"
API_V1_STR="/api"

# Database Configuration (MongoDB Atlas or Local)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="ai_email_summarizer"

# Security & JWT Authentication
JWT_SECRET_KEY="ai-email-summarizer-development-secret-key-32-chars-min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sensitive Data Encryption Key (32-byte Fernet base64 key)
ENCRYPTION_KEY="9_X0gQn7kGz7u9K-5uKq_9V3M2p_L5a7G9Z1w2E4r6Y="

# Application URLs & CORS
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"

# Google OAuth 2.0 Credentials (Optional for Demo Mode, required for real Gmail sync)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/gmail/callback"

# LLM Provider Configuration ("openai", "gemini", "anthropic", "groq", or "demo")
LLM_PROVIDER="demo"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
